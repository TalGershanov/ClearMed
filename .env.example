# OpenAI (used by server_init/create_clearmed_db.py)
OPENAI_API_KEY=

# DeepL (used by server_init/create_clearmed_db.py for Hebrew translation)
DEEPL_API_KEY=

# Google Cloud Vision (used by logic/ocr.py for photographed-document text extraction)
GOOGLE_CLOUD_VISION_API_KEY=

# OpenMRS REST API integration (openmrs/config.py)
OPENMRS_BASE_URL=https://o3.openmrs.org/openmrs
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
OPENMRS_TIMEOUT_SECONDS=10
OPENMRS_ORIGIN=https://clearmed.duckdns.org
OPENMRS_NOTE_CONCEPT_UUID=

# --- Patient app: application database (webapp/) ---
# Must point at the Postgres instance from docker-compose.yml (or your own).
DATABASE_URL=postgresql+psycopg2://clearmed:clearmed@localhost:5433/clearmed_app

# --- Patient app: auth (webapp/) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development | production -- controls the default for COOKIE_SECURE below
ENVIRONMENT=development
# Optional explicit override. Leave unset to default to true only when
# ENVIRONMENT=production. Must be true in production (HTTPS only).
# COOKIE_SECURE=false

# Comma-separated origins allowed to make credentialed (cookie) requests to
# the patient-app API. Defaults to the local Vite dev server if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides for patient-app document storage -- both have working
# defaults in webapp/core/config.py (an `uploads/` dir at the repo root, and
# a 20 MB cap) and don't need to be set for local development.
# LOCAL_STORAGE_DIR=
# MAX_UPLOAD_SIZE_BYTES=
