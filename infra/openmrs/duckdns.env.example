# Copy to duckdns.env, fill in your real token, and scp it to the instance
# alongside setup-host.sh (see infra/openmrs/README.md). Never commit the
# filled-in version — it's a bearer credential for your whole DuckDNS account.
#
# DUCKDNS_DOMAIN is just the subdomain part (no ".duckdns.org" suffix).
# Find your token at https://www.duckdns.org after logging in.

DUCKDNS_DOMAIN=clearmed-openmrs
DUCKDNS_TOKEN=REPLACE_ME
