# Copy to .env.production, fill in real values, then use it as instructed
# in infra/openmrs/README.md. Never commit the filled-in version.
#
# These become the `.env` for the upstream openmrs-distro-referenceapplication
# checkout on the EC2 host (setup-host.sh copies this file into place as
# `.env` in that checkout's directory).

# Pin an explicit release, not `qa`/`latest`, for reproducibility.
# Check https://github.com/openmrs/openmrs-distro-referenceapplication/tags
# for the current latest stable tag.
TAG=3.7.1

# Load the SSL overlay automatically so plain `docker compose up` picks it up.
COMPOSE_FILE=docker-compose.yml:docker-compose.ssl.yml

# Let's Encrypt (production) certificates.
SSL_MODE=prod
CERT_WEB_DOMAINS=clearmed-openmrs.duckdns.org
CERT_CONTACT_EMAIL=talgershanov@gmail.com
# Set to true once when first standing this up, to test against Let's Encrypt's
# staging environment and avoid burning production rate limits, then remove it.
# SSL_STAGING=true

# Database credentials — generate real random values, do not use these.
# e.g. `openssl rand -base64 24`
OMRS_DB_USER=clearmed_openmrs
OMRS_DB_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME
